# Copy to gradle.properties and fill in. That file is gitignored.
#
# Restrict this key in the Google Cloud console:
#   Application restriction: Android apps
#     package tech.hoppin.driver + your signing SHA-1
#   API restriction: Maps SDK for Android ONLY
MAPS_API_KEY=paste_the_android_maps_key_here

org.gradle.jvmargs=-Xmx4G
android.useAndroidX=true
android.enableJetifier=true
