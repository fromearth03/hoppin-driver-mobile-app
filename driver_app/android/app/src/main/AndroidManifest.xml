<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ══ HOPPIN DRIVER — ANDROID PERMISSIONS (v3.0 Phase 2) ═════════════════
         Was the stock `flutter create` scaffold until this phase: zero
         <uses-permission>, zero <service>. Every line below is load-bearing for
         one sentence — a driver with the screen LOCKED keeps heartbeating for
         an eight-hour shift and does not silently drop out of the dispatch pool.
    -->

    <!-- The API itself. `POST /drivers/me/location`, `POST /drivers/me/online`. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The heartbeat's payload. FINE is what dispatch needs; COARSE is declared
         because Android 12+ lets the driver GRANT ONLY COARSE from the system
         dialog, and an app that did not declare it would simply get nothing.
         A ~1-3km fix is a bad fix, but it is an HONEST bad fix and it is still
         a fix — the alternative is silence. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 🔴 THE ONE THAT MAKES THIS A DRIVER APP. Android 10 (API 29) split
         background location into a SEPARATE, SECOND-STAGE grant that cannot be
         requested in the same dialog as foreground location and cannot be
         requested at all until foreground is already held. Without it the
         foreground service still runs, but the OS delivers NO location updates
         once the app is not visible — which is the exact failure this phase
         exists to kill.

         A driver who declines this is STILL DISPATCHABLE WHILE THE APP IS OPEN.
         See `DriverBackgroundLocationNotice` — the app tells them precisely what
         they lose and never claims coverage it does not have. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- The foreground service itself, plus its Android-14 TYPE. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- 🔴 ANDROID 14 (API 34) THROWS if a service that accesses location starts
         without BOTH this permission AND a matching `foregroundServiceType` on
         the <service> below. Not a warning — a
         `MissingForegroundServiceTypeException` / SecurityException that kills
         the process the moment the driver taps GO. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13 (API 33) made the notification itself a runtime grant. The
         foreground service's persistent notification is what KEEPS the process
         alive; a driver who refuses this still gets the service, but with a
         silent, minimised notification — so we ask, and we degrade honestly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeps the CPU alive between location fixes across an 8-hour shift with
         the screen off. Without it Doze can stretch a 20-second heartbeat into
         a several-minute one, and 5 minutes without a ping is a dropped driver. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The service must come back up if the OS killed it mid-shift (memory
         pressure, an OEM battery killer). Declared, not yet consumed: nothing
         auto-restarts a shift the driver did not ask for. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Hoppin Driver"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 🔴 THE TYPED FOREGROUND SERVICE.

             `android:foregroundServiceType="location"` is the Android-14
             contract: a service that reads location while backgrounded must
             DECLARE that it does, and hold FOREGROUND_SERVICE_LOCATION above.
             Omit either half and `startForeground()` throws at runtime — the
             app dies the instant the driver goes online, on the exact devices
             our drivers actually own.

             `exported="false"`: nothing outside this app may start the shift
             service. `stopWithTask="false"`: swiping the app away from Recents
             does NOT end the shift. A driver who dismisses the task card has not
             clocked off — only tapping "Go offline" does that, and the service
             is the only thing keeping them in the dispatch pool. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
